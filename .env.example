# Set a unique >=12-character password before first Docker/manual start.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional local launcher binding. Use HTTPS before remote camera access.
HOST=127.0.0.1
PORT=8000
COOKIE_SECURE=false
PUBLIC_ORIGIN=
# Container overrides DATA_DIR; these defaults work for local launch.
DATA_DIR=./data
MODEL_DIR=./models
MAX_UPLOAD_MB=512
MAX_STORAGE_MB=10240
MAX_ACTIVE_JOBS=2
MAX_ANALYZED_FRAMES=30000
MAX_LIVE_SECONDS=3600
INFERENCE_THREADS=2

